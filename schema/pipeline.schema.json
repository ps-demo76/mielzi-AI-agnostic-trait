{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mielzie Reasoning Pipeline",
  "type": "object",
  "properties": {
    "step": {
      "type": "integer",
      "description": "1-12"
    },
    "agent": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "input": {
      "type": "string"
    },
    "output": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "step",
    "agent",
    "role",
    "input",
    "output"
  ],
  "description": "One step of the 12-step pipeline"
}